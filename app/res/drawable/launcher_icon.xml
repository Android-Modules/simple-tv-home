            <size android:width="64dp" android:height="64dp" />
            <corners android:radius="15dp" />
            <solid android:color="#21242B" />
        </shape>
    </item>
    <item android:left="12dp" android:top="15dp" android:right="12dp" android:bottom="15dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <stroke android:width="2dp" android:color="#F3F5F9" />
        </shape>
    </item>
    <item android:left="17dp" android:top="20dp" android:right="39dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#9FC0FF" />
        </shape>
    </item>
</layer-list>
